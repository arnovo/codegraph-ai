APP_NAME="Codebase Memory Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=codebase_chat
DB_USERNAME=codebase
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=reverb

# --- MCP (codebase-memory-mcp 0.8.1 — runs on HOST, not in Docker) ---
# Start manually: codebase-memory-mcp --ui=true --port=9749
MCP_RPC_URL=http://host.docker.internal:9749/rpc
MCP_UI_URL=http://localhost:9749
MCP_BINARY=codebase-memory-mcp
MCP_HEALTH_TIMEOUT=3
MCP_ON_HOST=true
MCP_CLI_FALLBACK=false
MCP_PROJECTS_CACHE_TTL=300
MCP_PROJECTS_CACHE_STALE_AFTER=30
PROJECTS_FILTER_PRINEX_ONLY=true
MCP_TOOLS_CACHE_ENABLED=true
MCP_TOOLS_CACHE_TTL=3600

# Host path mounted read-only into app/MCP containers.
# En dev local suele ser la misma ruta en host y contenedor (véase docker-compose.yml).
REPOS_HOST_PATH=/Users/you/APPs
REPOS_CONTAINER_PATH=/Users/you/APPs

# --- Agent engine ---
# internal = LLM API + MCP tools (default)
# cursor_cli = Cursor agent CLI sobre CURSOR_WORKSPACE_PATH
AGENT_ENGINE=internal

# --- Cursor CLI (solo si AGENT_ENGINE=cursor_cli) ---
# Instalar: curl https://cursor.com/install -fsS | bash  → binario `agent`
# Auth: CURSOR_API_KEY o `agent login`
CURSOR_API_KEY=
CURSOR_WORKSPACE_PATH=/Users/you/APPs
CURSOR_CLI_BINARY=agent
CURSOR_AGENT_MODE=ask
CURSOR_AGENT_TRUST=true
CURSOR_AGENT_TIMEOUT_SECONDS=600
CURSOR_AGENT_OUTPUT_FORMAT=text

# --- Git / sync de repos ---
# Credenciales para clone/pull HTTPS (Bitbucket/GitHub). No commitear valores reales.
GIT_USERNAME=
GIT_TOKEN=
# URLs git separadas por espacio, coma o salto de línea
GIT_REPOS_URLS=
GIT_ALLOWED_HOSTS=bitbucket.org
GIT_CLONE_TIMEOUT_SECONDS=600
# GIT_REPOS_URLS="https://bitbucket.org/prinex/proyecto-a.git https://bitbucket.org/prinex/proyecto-b.git"
GIT_SYNC_ON_START=false
GIT_SYNC_INTERVAL_MINUTES=60
GIT_USER_NAME="Codebase Assistant"
GIT_USER_EMAIL=codebase-assistant@example.com

# --- MCP Docker (producción; profile mcp-docker) ---
MCP_DOCKER_SERVICE=mcp
DOCKER_COMPOSE_FILE=docker-compose.yml
MCP_PORT=9749
# MCP_ON_HOST=false
# MCP_RPC_URL=http://mcp:9749/rpc

# --- LLM (OpenAI-compatible) ---
# OpenAI: LLM_DRIVER=openai, LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini
# Gemini (OpenAI-compatible): base URL abajo. Modelos probados con tools:
#   gemini-3.5-flash-lite      ← recomendado free tier (barato, tools OK)
#   gemini-flash-lite-latest   ← alias estable lite
#   gemini-3.1-flash-lite      ← alternativa lite
#   gemini-flash-latest        ← apunta a 3.6-flash, cuota free muy baja (~20/min)
#   gemini-2.0-flash           ← existe pero cuota free separada (429 frecuente)
#   gemini-2.5-flash           ← NO soportado en endpoint /openai (404)
# LLM_DRIVER=custom
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
LLM_DRIVER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOOL_ITERATIONS=3
LLM_STREAM=true
LLM_LOG_TRAFFIC=true

# Azure OpenAI (only when LLM_DRIVER=azure)
LLM_AZURE_API_KEY=
LLM_AZURE_ENDPOINT=
LLM_AZURE_DEPLOYMENT=
LLM_AZURE_API_VERSION=2024-08-01-preview

VITE_APP_NAME="${APP_NAME}"

# --- Reverb WebSocket (MCP status push) ---
# Browser local: nginx proxy WS en /app → reverb:8081 (puerto APP 8080).
# Docker PHP broadcast: compose sobreescribe REVERB_HOST=reverb REVERB_PORT=8081.
#
# Cloudflare Tunnel (recomendado: un solo túnel al puerto nginx, NO a reverb:8081):
#   cloudflared tunnel --url http://localhost:8080
#   APP_URL=https://tu-subdominio.trycloudflare.com
#   VITE_REVERB_USE_CURRENT_ORIGIN=true
#   (o deja VITE_REVERB_HOST=localhost: echo detecta túnel y usa wss://mismo-host:443/app)
# Tras cambiar VITE_*: pnpm run build (assets embebidos).
REVERB_APP_ID=codebase-chat
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_USE_CURRENT_ORIGIN=false
