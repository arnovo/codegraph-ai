{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "resources/js/env.d.ts",
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "resources/js/revision.json"
    ],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./resources/js/*"],
            "@css/*": ["./resources/css/*"]
        },
        "plugins": [
            {
                "name": "@vue/typescript-plugin"
            }
        ]
    },
    "vueCompilerOptions": {
        "target": 3
    }
}
